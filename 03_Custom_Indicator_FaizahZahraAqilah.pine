// This Pine Script(R) code is subject to the terms of the Mozilla Public License 2.0
// =====================================================================================
//  RACS - Regime-Adaptive Composite Signal                                       v1.2
//  Penulis : Faizah Zahra Aqilah - MLE Internship GIBEI Telkom University
//  Status  : desain dibekukan sebelum periode uji dibuka (tanggal dicatat di laporan)
//  v1.1    : normalisasi persentil BERTANDA (titik nol dipertahankan), durasi filter
//            squeeze dipisah dari horizon evaluasi, tabel default Off, Spearman dengan
//            rank rata-rata untuk nilai kembar.
//  v1.2    : HANYA keluaran deskriptif baru di tabel benchmark (volatilitas tahunan,
//            korelasi komponen, porsi rezim, periode pengembangan). Sinyal identik v1.1.
// -------------------------------------------------------------------------------------
//  RINGKAS
//  Skor arah -100..+100. Bobot dua logika ditentukan secara KONTINU oleh ADX:
//    w = clip((ADX - 20) / (25 - 20), 0, 1)          (Pers. 17 di laporan)
//    S = 100 * [ w * S_trend + (1 - w) * g * S_mr ]   (Pers. 19)
//      S_trend = rata-rata(C_trend, C_mom, C_vol)      -> logika tren + konfirmasi volume
//      S_mr    = rata-rata(C_pctB, C_mfi)              -> logika mean reversion (MFI sudah
//                                                         memuat volume secara konsisten)
//      g       = 0 jika squeeze Bollinger terjadi <= m bar terakhir (risiko breakout), 1 lainnya
//                (m = durasi filter squeeze, input terpisah dari horizon evaluasi h)
//  Normalisasi (Pers. 13): N(x) = sign(x) * persentil_252(|x|), di [-1, 1].
//  Tanda x dipertahankan, jadi N > 0 tetap berarti "arah naik / murah" dan N = 0 tetap
//  netral. Yang disamakan hanya skala (sebaran |x|) antar komponen. Komponen dipusatkan
//  dulu pada titik netralnya: RSI - 50, 0,5 - %B, 50 - MFI.
//
//  SINYAL
//    Ambang = persentil P90 / P10 skor di PERIODE PENGEMBANGAN (dihitung otomatis, lalu
//    tetap). Histeresis: setelah sinyal beli, sinyal beli baru hanya bisa muncul setelah
//    skor kembali <= 0 (simetris untuk jual).
//    Beli = trade long (dengan biaya). Jual = prediksi arah turun (tanpa biaya), karena
//    short selling ritel di BEI praktis tidak tersedia.
//
//  ANTI LOOKAHEAD
//    - Pembentukan sinyal hanya memakai data bar t dan sebelumnya (fungsi ta.* bawaan,
//      tanpa request.security, tanpa plot offset negatif).
//    - Entry di OPEN bar t+1, exit di CLOSE bar t+h. Evaluasi memang memakai data
//      setelah t; yang dijaga adalah sinyalnya, bukan evaluasinya.
//    - Sinyal yang horizonnya melewati akhir periode uji dibuang.
//    - Sinyal dikunci dengan barstate.isconfirmed (tidak repaint di bar berjalan).
//    - Entry tidak valid jika bar t+1 tidak punya volume atau high == low (suspensi /
//      terkunci ARA-ARB).
//
//  SETTING CHART: timeframe 1D, "Adjust data for dividends" = ON (lihat laporan Bab 6).
//
//  Kesesuaian rumus: RSI, ATR, ADX/DMI memakai Wilder smoothing (RMA) dari ta.rsi,
//  ta.atr, ta.dmi; Bollinger memakai ta.bb (simpangan baku populasi); MFI dari ta.mfi.
// =====================================================================================

//@version=6
indicator("Regime-Adaptive Composite Signal [RACS] v1.2", shorttitle = "RACS", overlay = false, precision = 1)

// ---------------------------------------------------------------- 1. INPUT
grpC = "Komponen"
lenFast = input.int(20,    "EMA cepat (konvensi praktisi)",  minval = 2, group = grpC)
lenSlow = input.int(50,    "EMA lambat (konvensi praktisi)", minval = 3, group = grpC)
lenW    = input.int(14,    "RSI / ATR / ADX / MFI (Wilder)", minval = 2, group = grpC)
lenBb   = input.int(20,    "Bollinger length (Bollinger)",   minval = 2, group = grpC)
multBb  = input.float(2.0, "Bollinger k (Bollinger)",        minval = 0.5, step = 0.1, group = grpC)
lenVol  = input.int(20,    "Panjang EMA komponen volume",    minval = 2, group = grpC)

grpN = "Normalisasi, rezim, squeeze"
lenRank = input.int(252,    "Jendela persentil (1 tahun bursa)", minval = 20, group = grpN)
adxLo   = input.float(20.0, "ADX batas bawah (konvensi)",        minval = 1,  group = grpN)
adxHi   = input.float(25.0, "ADX batas atas (konvensi)",         minval = 2,  group = grpN)
lenSqz  = input.int(120,    "Squeeze: bandwidth terendah N bar (~6 bln)", minval = 10, group = grpN)
sqzHold = input.int(5,      "Squeeze: durasi filter m (bar)",     minval = 0,  group = grpN)  // terpisah dari horizon h

grpP = "Periode & evaluasi"
devStart  = input.time(timestamp("01 Jan 2019 00:00 +0700"), "Pengembangan: mulai",  group = grpP)
devEnd    = input.time(timestamp("31 Dec 2023 23:59 +0700"), "Pengembangan: akhir",  group = grpP)
testStart = input.time(timestamp("01 Jan 2024 00:00 +0700"), "Uji: mulai",           group = grpP)
testEnd   = input.time(timestamp("31 Dec 2025 23:59 +0700"), "Uji: akhir",           group = grpP)
pctTh     = input.float(90.0, "Persentil ambang sinyal (P dan 100-P)", minval = 60, maxval = 99, group = grpP)
hz        = input.int(5, "Horizon h (bar)", minval = 1, maxval = 60, group = grpP)
costPct   = input.float(0.40, "Biaya round-trip (%)", minval = 0, step = 0.05, group = grpP)
condSel   = input.string("Semua", "Kondisi pasar saat sinyal", options = ["Semua", "Bullish", "Bearish", "Sideways"], group = grpP)
// Default Off: tabel periode uji hanya dibuka SETELAH kode dibekukan (cegah kontaminasi).
tblMode   = input.string("Off", "Tabel", options = ["Off", "Benchmark 6 indikator", "Uji RACS"], group = grpP)

// ---------------------------------------------------------------- 2. FUNGSI BANTU
// Persentil bergulir BERTANDA -> [-1, 1]: N(x) = sign(x) * PR_252(|x|).
// ta.percentrank = % nilai lampau <= nilai sekarang. Tanda x dipertahankan sehingga
// titik nol tetap berarti netral; hanya skala yang disamakan antar komponen.
f_srank(float x) =>
    pr = ta.percentrank(math.abs(x), lenRank)
    na(pr) or na(x) ? na : math.sign(x) * pr / 100.0

f_clip(float x, float lo, float hi) =>
    math.max(math.min(x, hi), lo)

// ---------------------------------------------------------------- 3. KOMPONEN MENTAH
emaF   = ta.ema(close, lenFast)
emaS   = ta.ema(close, lenSlow)
atrV   = ta.atr(lenW)
rawTr  = atrV > 0 ? (emaF - emaS) / atrV : na                  // tren dalam satuan ATR

rsiV   = ta.rsi(close, lenW)                                    // momentum

sv     = math.sign(close - nz(close[1], close)) * nz(volume)    // volume bertanda
numV   = ta.ema(sv, lenVol)
denV   = ta.ema(nz(volume), lenVol)
rawVol = denV > 0 ? numV / denV : na                            // terbatas [-1,1], stasioner

[bbMid, bbUp, bbLo] = ta.bb(close, lenBb, multBb)
bbW    = bbUp - bbLo
pctB   = bbW > 0 ? (close - bbLo) / bbW : na
mfiV   = ta.mfi(hlc3, lenW)

// ---------------------------------------------------------------- 4. KOMPONEN TERNORMALISASI [-1, 1]
// Setiap komponen dipusatkan pada titik netralnya sebelum dinormalisasi.
cTr  = f_srank(rawTr)            // > 0: EMA cepat di atas EMA lambat
cMom = f_srank(rsiV - 50.0)      // > 0: RSI di atas 50
cVol = f_srank(rawVol)           // > 0: volume dominan di hari naik
cB   = f_srank(0.5 - pctB)       // > 0: harga di bawah tengah pita (dekat pita bawah) -> beli
cM   = f_srank(50.0 - mfiV)      // > 0: MFI di bawah 50 (arah oversold berbobot volume) -> beli

// ---------------------------------------------------------------- 5. REZIM & SQUEEZE
[diP, diM, adxV] = ta.dmi(lenW, lenW)
wT    = f_clip((adxV - adxLo) / (adxHi - adxLo), 0.0, 1.0)

bwN   = bbMid > 0 ? bbW / bbMid : na                            // bandwidth Bollinger
sqz   = bwN <= ta.lowest(bwN, lenSqz)
bsSqz = ta.barssince(sqz)
gMr   = not na(bsSqz) and bsSqz <= sqzHold ? 0.0 : 1.0          // matikan mean reversion dekat squeeze

// ---------------------------------------------------------------- 6. SKOR + VARIAN ABLATION
sTr3  = (cTr + cMom + cVol) / 3.0
sMr   = (cB + cM) / 2.0
scFull  = 100.0 * (wT * sTr3 + (1.0 - wT) * gMr * sMr)
scNoReg = 100.0 * sTr3                                                       // tanpa filter rezim
scNoVol = 100.0 * (wT * (cTr + cMom) / 2.0 + (1.0 - wT) * gMr * sMr)        // tanpa volume
scNoMom = 100.0 * (wT * (cTr + cVol) / 2.0 + (1.0 - wT) * gMr * sMr)        // tanpa RSI
scNoSqz = 100.0 * (wT * sTr3 + (1.0 - wT) * sMr)                             // tanpa filter squeeze

// ---------------------------------------------------------------- 7. KALIBRASI AMBANG + HISTERESIS
f_signals(float sc) =>
    var array<float> cal = array.new_float()
    var float thU = na
    var float thD = na
    var int state = 0
    if time >= devStart and time <= devEnd and not na(sc)
        cal.push(sc)
    if na(thU) and time > devEnd and cal.size() >= 100
        thU := cal.percentile_linear_interpolation(pctTh)
        thD := cal.percentile_linear_interpolation(100.0 - pctTh)
    buy  = false
    sell = false
    if not na(thU) and not na(sc)
        if state != 1 and sc >= thU
            buy   := true
            state := 1
        else if state != -1 and sc <= thD
            sell  := true
            state := -1
        else if state == 1 and sc <= 0
            state := 0
        else if state == -1 and sc >= 0
            state := 0
    [buy, sell, thU, thD]

[bFull, sFull, thU, thD] = f_signals(scFull)
[bNoReg, sNoReg, u2, d2] = f_signals(scNoReg)
[bNoVol, sNoVol, u3, d3] = f_signals(scNoVol)
[bNoMom, sNoMom, u4, d4] = f_signals(scNoMom)
[bNoSqz, sNoSqz, u5, d5] = f_signals(scNoSqz)

// ---------------------------------------------------------------- 8. BASELINE & BENCHMARK (aturan standar)
[mL, mS, mH] = ta.macd(close, 12, 26, 9)
macdBuy  = ta.crossover(mL, mS)
macdSell = ta.crossunder(mL, mS)
mzBuy    = ta.crossover(mL, 0)           // MACD(12,26,0) seperti Chong et al. (2014)
mzSell   = ta.crossunder(mL, 0)
maBuy    = ta.crossover(emaF, emaS)
maSell   = ta.crossunder(emaF, emaS)
rsiBuy   = ta.crossover(rsiV, 30)
rsiSell  = ta.crossunder(rsiV, 70)
bbBuy    = ta.crossover(close, bbLo)
bbSell   = ta.crossunder(close, bbUp)
obvV     = ta.obv
obvE     = ta.ema(obvV, 20)
obvBuy   = ta.crossover(obvV, obvE)
obvSell  = ta.crossunder(obvV, obvE)
diUp     = ta.crossover(diP, diM)
diDn     = ta.crossunder(diP, diM)
adxBuy   = diUp and adxV > 25
adxSell  = diDn and adxV > 25

// ---------------------------------------------------------------- 9. LABEL KONDISI PASAR (diskalakan volatilitas)
lr60  = math.log(close / close[60])
sdD   = ta.stdev(math.log(close / nz(close[1], close)), 60)
z60   = sdD > 0 ? lr60 / (sdD * math.sqrt(60)) : na
cond  = na(z60) ? 0 : z60 > 1 ? 1 : z60 < -1 ? -1 : 0
condOk = condSel == "Semua" or (condSel == "Bullish" and cond == 1) or (condSel == "Bearish" and cond == -1) or (condSel == "Sideways" and cond == 0 and not na(z60))

// ---------------------------------------------------------------- 10. EVALUASI (entry open t+1, exit close t+h)
entryOk = nz(volume[hz - 1]) > 0 and high[hz - 1] > low[hz - 1]
fwdR    = (close / open[hz - 1] - 1.0) * 100.0

f_valid(int wS, int wE) =>
    not na(time[hz]) and time[hz] >= wS and time <= wE and condOk[hz] and entryOk

f_eval(bool sig, bool isLong, int wS, int wE) =>
    var int n = 0
    var int w = 0
    var array<float> rs = array.new_float()
    ok = f_valid(wS, wE)
    if sig[hz] and ok
        rn = isLong ? fwdR - costPct : -fwdR
        n += 1
        w += rn > 0 ? 1 : 0
        rs.push(rn)
    [n, w, rs]

f_base(int wS, int wE) =>
    var int nA = 0
    var int nU = 0
    var int nD = 0
    ok = f_valid(wS, wE)
    if ok
        nA += 1
        nU += fwdR - costPct > 0 ? 1 : 0
        nD += fwdR < 0 ? 1 : 0
    [nA, nU, nD]

f_icCollect(float sc, int wS, int wE) =>
    var array<float> xs = array.new_float()
    var array<float> ys = array.new_float()
    ok = f_valid(wS, wE)
    if not na(sc[hz]) and ok
        xs.push(sc[hz])
        ys.push(fwdR)
    [xs, ys]

// Rank dengan rata-rata untuk nilai kembar (skor bisa persis 0 berkali-kali saat
// ADX < 20 dan filter squeeze aktif). Tanpa ini, nilai kembar diberi rank sembarang.
f_ranks(array<float> a) =>
    n = a.size()
    r = array.new_float(n, 0.0)
    if n > 0
        idx = a.sort_indices(order.ascending)
        i = 0
        while i < n
            j = i
            while j + 1 < n and a.get(idx.get(j + 1)) == a.get(idx.get(i))
                j += 1
            avgRank = (i + j) / 2.0
            for k = i to j
                r.set(idx.get(k), avgRank)
            i := j + 1
    r

f_spearman(array<float> a, array<float> b) =>
    n = a.size()
    float rho = na
    if n >= 10
        ra = f_ranks(a)
        rb = f_ranks(b)
        ma = ra.avg()
        mb = rb.avg()
        sab = 0.0
        saa = 0.0
        sbb = 0.0
        for i = 0 to n - 1
            da = ra.get(i) - ma
            db = rb.get(i) - mb
            sab += da * db
            saa += da * da
            sbb += db * db
        rho := saa > 0 and sbb > 0 ? sab / math.sqrt(saa * sbb) : na
    rho

// Uji (2024-2025)
[nB0, nU0, nD0] = f_base(testStart, testEnd)
[n1, w1, r1]   = f_eval(bFull,  true,  testStart, testEnd)
[n2, w2, r2]   = f_eval(sFull,  false, testStart, testEnd)
[n3, w3, r3]   = f_eval(bNoReg, true,  testStart, testEnd)
[n4, w4, r4]   = f_eval(sNoReg, false, testStart, testEnd)
[n5, w5, r5]   = f_eval(bNoVol, true,  testStart, testEnd)
[n6, w6, r6]   = f_eval(sNoVol, false, testStart, testEnd)
[n7, w7, r7]   = f_eval(bNoMom, true,  testStart, testEnd)
[n8, w8, r8]   = f_eval(sNoMom, false, testStart, testEnd)
[n9, w9, r9]   = f_eval(bNoSqz, true,  testStart, testEnd)
[n10, w10, r10] = f_eval(sNoSqz, false, testStart, testEnd)
[n11, w11, r11] = f_eval(macdBuy,  true,  testStart, testEnd)
[n12, w12, r12] = f_eval(macdSell, false, testStart, testEnd)
[n13, w13, r13] = f_eval(mzBuy,    true,  testStart, testEnd)
[n14, w14, r14] = f_eval(mzSell,   false, testStart, testEnd)
[x1, y1] = f_icCollect(scFull,  testStart, testEnd)
[x2, y2] = f_icCollect(scNoReg, testStart, testEnd)
[x3, y3] = f_icCollect(scNoVol, testStart, testEnd)
[x4, y4] = f_icCollect(scNoMom, testStart, testEnd)
[x5, y5] = f_icCollect(scNoSqz, testStart, testEnd)

// Benchmark 6 indikator (periode pengembangan 2019-2023)
[nBd, nUd, nDd] = f_base(devStart, devEnd)
[k1, v1, q1]   = f_eval(maBuy,    true,  devStart, devEnd)
[k2, v2, q2]   = f_eval(maSell,   false, devStart, devEnd)
[k3, v3, q3]   = f_eval(macdBuy,  true,  devStart, devEnd)
[k4, v4, q4]   = f_eval(macdSell, false, devStart, devEnd)
[k5, v5, q5]   = f_eval(rsiBuy,   true,  devStart, devEnd)
[k6, v6, q6]   = f_eval(rsiSell,  false, devStart, devEnd)
[k7, v7, q7]   = f_eval(bbBuy,    true,  devStart, devEnd)
[k8, v8, q8]   = f_eval(bbSell,   false, devStart, devEnd)
[k9, v9, q9]   = f_eval(obvBuy,   true,  devStart, devEnd)
[k10, v10, q10] = f_eval(obvSell, false, devStart, devEnd)
[k11, v11, q11] = f_eval(adxBuy,  true,  devStart, devEnd)
[k12, v12, q12] = f_eval(adxSell, false, devStart, devEnd)

// ---------------------------------------------------------------- 10b. DESKRIPTIF PERIODE PENGEMBANGAN (v1.2)
// Hanya untuk laporan (Tabel 6 dan Lampiran B); tidak dipakai dalam sinyal.
inDev = time >= devStart and time <= devEnd

// Volatilitas tahunan realisasi: simpangan baku sampel return log harian x sqrt(252)
var float sLr  = 0.0
var float sLr2 = 0.0
var int   nLr  = 0
lrD = math.log(close / close[1])
if inDev and not na(lrD)
    sLr  += lrD
    sLr2 += lrD * lrD
    nLr  += 1
sigAnn = nLr > 1 ? math.sqrt(math.max(sLr2 - sLr * sLr / nLr, 0.0) / (nLr - 1)) * math.sqrt(252) * 100.0 : na

// Korelasi Pearson dua komponen, diakumulasi selama periode pengembangan
f_corr(float a, float b, bool on) =>
    var float sa = 0.0
    var float sb = 0.0
    var float saa = 0.0
    var float sbb = 0.0
    var float sab = 0.0
    var int   n = 0
    if on and not na(a) and not na(b)
        sa  += a
        sb  += b
        saa += a * a
        sbb += b * b
        sab += a * b
        n   += 1
    va = saa - sa * sa / math.max(n, 1)
    vb = sbb - sb * sb / math.max(n, 1)
    n > 2 and va > 0 and vb > 0 ? (sab - sa * sb / n) / math.sqrt(va * vb) : na

rTrMom  = f_corr(cTr,  cMom, inDev)
rTrVol  = f_corr(cTr,  cVol, inDev)
rMomVol = f_corr(cMom, cVol, inDev)
rBM     = f_corr(cB,   cM,   inDev)

// Porsi hari per rezim
var int nDev  = 0
var int nTrnd = 0
var int nSide = 0
if inDev and not na(wT)
    nDev  += 1
    nTrnd += wT >= 1.0 ? 1 : 0
    nSide += wT <= 0.0 ? 1 : 0

// Buy-and-hold periode uji (konteks)
var float bhOpen  = na
var float bhClose = na
if na(bhOpen) and time >= testStart
    bhOpen := open
if time >= testStart and time <= testEnd
    bhClose := close
bhRet = not na(bhOpen) and not na(bhClose) ? (bhClose / bhOpen - 1.0) * 100.0 : na

// ---------------------------------------------------------------- 11. VISUALISASI
buyC  = bFull and barstate.isconfirmed
sellC = sFull and barstate.isconfirmed
colUp = color.new(color.teal, 0)
colDn = color.new(color.red, 0)

bgcolor(color.from_gradient(wT, 0.0, 1.0, color.new(color.gray, 94), color.new(color.blue, 85)), title = "Bobot rezim tren w (biru = trending)")
hline(0, "Nol", color = color.gray, linestyle = hline.style_dotted)
plot(thU, "Ambang beli (P90 pengembangan)", color = color.new(color.teal, 50), style = plot.style_linebr)
plot(thD, "Ambang jual (P10 pengembangan)", color = color.new(color.red, 50),  style = plot.style_linebr)
plot(scFull, "Skor RACS", color = scFull >= 0 ? colUp : colDn, linewidth = 2)
plotshape(buyC  ? scFull : na, "Beli", shape.triangleup,   location.absolute, colUp, size = size.tiny)
plotshape(sellC ? scFull : na, "Jual", shape.triangledown, location.absolute, colDn, size = size.tiny)
plotshape(gMr == 0.0, "Risiko breakout (squeeze)", shape.diamond, location.bottom, color.new(color.orange, 30), size = size.tiny)

plot(100 * cTr,  "C tren",  color = color.orange, display = display.none)
plot(100 * cMom, "C RSI",   color = color.purple, display = display.none)
plot(100 * cVol, "C volume", color = color.olive, display = display.none)
plot(100 * cB,   "C %B",    color = color.aqua,   display = display.none)
plot(100 * cM,   "C MFI",   color = color.maroon, display = display.none)
plot(adxV,       "ADX",     color = color.gray,   display = display.none)

alertcondition(buyC,  "RACS Beli", "RACS: skor menembus ambang beli")
alertcondition(sellC, "RACS Jual", "RACS: skor menembus ambang jual")

// ---------------------------------------------------------------- 12. TABEL
f_fmtPct(float x, string f) =>
    na(x) ? "-" : str.tostring(x, f) + "%"

f_cell(table tbl, int c, int r, string txt) =>
    table.cell(tbl, c, r, txt, text_color = color.white, text_size = size.tiny)

// Baris: nama | N | hit | CI95 Wilson | base | z binomial | mean | median
f_row(table tbl, int row, string name, int n, int w, array<float> rs, float p0) =>
    hit = n > 0 ? float(w) / n : na
    zc  = 1.96
    nn  = math.max(n, 1)
    den = 1.0 + zc * zc / nn
    ctr = (nz(hit) + zc * zc / (2.0 * nn)) / den
    hw  = zc * math.sqrt(nz(hit) * (1.0 - nz(hit)) / nn + zc * zc / (4.0 * nn * nn)) / den
    z   = n > 0 and p0 > 0 and p0 < 1 ? (w - n * p0) / math.sqrt(n * p0 * (1.0 - p0)) : na
    f_cell(tbl, 0, row, name)
    f_cell(tbl, 1, row, str.tostring(n))
    f_cell(tbl, 2, row, f_fmtPct(na(hit) ? na : 100 * hit, "#.0"))
    f_cell(tbl, 3, row, n > 0 ? str.tostring(100 * (ctr - hw), "#") + "-" + str.tostring(100 * (ctr + hw), "#") + "%" : "-")
    f_cell(tbl, 4, row, f_fmtPct(na(p0) ? na : 100 * p0, "#.0"))
    f_cell(tbl, 5, row, na(z) ? "-" : str.tostring(z, "#.00"))
    f_cell(tbl, 6, row, f_fmtPct(rs.size() > 0 ? rs.avg() : na, "#.00"))
    f_cell(tbl, 7, row, f_fmtPct(rs.size() > 0 ? rs.median() : na, "#.00"))

f_header(table tbl, string first) =>
    f_cell(tbl, 0, 0, first)
    f_cell(tbl, 1, 0, "N")
    f_cell(tbl, 2, 0, "Hit")
    f_cell(tbl, 3, 0, "CI95")
    f_cell(tbl, 4, 0, "Base")
    f_cell(tbl, 5, 0, "z")
    f_cell(tbl, 6, 0, "Mean")
    f_cell(tbl, 7, 0, "Median")

var table tbl = table.new(position.top_right, 8, 24, bgcolor = color.new(color.black, 20), border_width = 1)

if barstate.islast and tblMode != "Off"
    pU0 = nB0 > 0 ? float(nU0) / nB0 : na
    pD0 = nB0 > 0 ? float(nD0) / nB0 : na
    pUd = nBd > 0 ? float(nUd) / nBd : na
    pDd = nBd > 0 ? float(nDd) / nBd : na
    if tblMode == "Uji RACS"
        f_header(tbl, "UJI h=" + str.tostring(hz) + " | " + condSel)
        f_row(tbl, 1,  "RACS Beli",          n1,  w1,  r1,  pU0)
        f_row(tbl, 2,  "RACS Jual (arah)",   n2,  w2,  r2,  pD0)
        f_row(tbl, 3,  "-Rezim Beli",        n3,  w3,  r3,  pU0)
        f_row(tbl, 4,  "-Rezim Jual",        n4,  w4,  r4,  pD0)
        f_row(tbl, 5,  "-Volume Beli",       n5,  w5,  r5,  pU0)
        f_row(tbl, 6,  "-Volume Jual",       n6,  w6,  r6,  pD0)
        f_row(tbl, 7,  "-RSI Beli",          n7,  w7,  r7,  pU0)
        f_row(tbl, 8,  "-RSI Jual",          n8,  w8,  r8,  pD0)
        f_row(tbl, 9,  "-Squeeze Beli",      n9,  w9,  r9,  pU0)
        f_row(tbl, 10, "-Squeeze Jual",      n10, w10, r10, pD0)
        f_row(tbl, 11, "MACD sig Beli",      n11, w11, r11, pU0)
        f_row(tbl, 12, "MACD sig Jual",      n12, w12, r12, pD0)
        f_row(tbl, 13, "MACD nol Beli",      n13, w13, r13, pU0)
        f_row(tbl, 14, "MACD nol Jual",      n14, w14, r14, pD0)
        f_cell(tbl, 0, 15, "IC Spearman")
        f_cell(tbl, 1, 15, "n")
        f_cell(tbl, 2, 15, "IC")
        f_cell(tbl, 0, 16, "RACS penuh")
        f_cell(tbl, 1, 16, str.tostring(x1.size()))
        f_cell(tbl, 2, 16, str.tostring(f_spearman(x1, y1), "#.000"))
        f_cell(tbl, 0, 17, "-Rezim")
        f_cell(tbl, 1, 17, str.tostring(x2.size()))
        f_cell(tbl, 2, 17, str.tostring(f_spearman(x2, y2), "#.000"))
        f_cell(tbl, 0, 18, "-Volume")
        f_cell(tbl, 1, 18, str.tostring(x3.size()))
        f_cell(tbl, 2, 18, str.tostring(f_spearman(x3, y3), "#.000"))
        f_cell(tbl, 0, 19, "-RSI")
        f_cell(tbl, 1, 19, str.tostring(x4.size()))
        f_cell(tbl, 2, 19, str.tostring(f_spearman(x4, y4), "#.000"))
        f_cell(tbl, 0, 20, "-Squeeze")
        f_cell(tbl, 1, 20, str.tostring(x5.size()))
        f_cell(tbl, 2, 20, str.tostring(f_spearman(x5, y5), "#.000"))
        f_cell(tbl, 0, 21, "Ambang P" + str.tostring(pctTh, "#") + "/P" + str.tostring(100 - pctTh, "#"))
        f_cell(tbl, 1, 21, na(thU) ? "-" : str.tostring(thU, "#.0") + " / " + str.tostring(thD, "#.0"))
        f_cell(tbl, 0, 22, "Buy & hold uji")
        f_cell(tbl, 1, 22, f_fmtPct(bhRet, "#.0"))
        f_cell(tbl, 0, 23, "Jendela base (n)")
        f_cell(tbl, 1, 23, str.tostring(nB0))
    else
        f_header(tbl, "BENCHMARK DEV h=" + str.tostring(hz) + " | " + condSel)
        f_row(tbl, 1,  "EMA20/50 Beli",   k1,  v1,  q1,  pUd)
        f_row(tbl, 2,  "EMA20/50 Jual",   k2,  v2,  q2,  pDd)
        f_row(tbl, 3,  "MACD Beli",       k3,  v3,  q3,  pUd)
        f_row(tbl, 4,  "MACD Jual",       k4,  v4,  q4,  pDd)
        f_row(tbl, 5,  "RSI 30 Beli",     k5,  v5,  q5,  pUd)
        f_row(tbl, 6,  "RSI 70 Jual",     k6,  v6,  q6,  pDd)
        f_row(tbl, 7,  "BB bawah Beli",   k7,  v7,  q7,  pUd)
        f_row(tbl, 8,  "BB atas Jual",    k8,  v8,  q8,  pDd)
        f_row(tbl, 9,  "OBV Beli",        k9,  v9,  q9,  pUd)
        f_row(tbl, 10, "OBV Jual",        k10, v10, q10, pDd)
        f_row(tbl, 11, "DMI+ADX25 Beli",  k11, v11, q11, pUd)
        f_row(tbl, 12, "DMI+ADX25 Jual",  k12, v12, q12, pDd)
        f_cell(tbl, 0, 13, "Jendela base (n)")
        f_cell(tbl, 1, 13, str.tostring(nBd))
        f_cell(tbl, 0, 14, "Volatilitas tahunan dev")
        f_cell(tbl, 1, 14, f_fmtPct(sigAnn, "#.0"))
        f_cell(tbl, 0, 15, "Korelasi tren-RSI")
        f_cell(tbl, 1, 15, na(rTrMom) ? "-" : str.tostring(rTrMom, "#.00"))
        f_cell(tbl, 0, 16, "Korelasi tren-volume")
        f_cell(tbl, 1, 16, na(rTrVol) ? "-" : str.tostring(rTrVol, "#.00"))
        f_cell(tbl, 0, 17, "Korelasi RSI-volume")
        f_cell(tbl, 1, 17, na(rMomVol) ? "-" : str.tostring(rMomVol, "#.00"))
        f_cell(tbl, 0, 18, "Korelasi %B-MFI")
        f_cell(tbl, 1, 18, na(rBM) ? "-" : str.tostring(rBM, "#.00"))
        f_cell(tbl, 0, 19, "Hari ADX>=25 / <=20")
        f_cell(tbl, 1, 19, nDev > 0 ? str.tostring(100.0 * nTrnd / nDev, "#") + "% / " + str.tostring(100.0 * nSide / nDev, "#") + "%" : "-")
